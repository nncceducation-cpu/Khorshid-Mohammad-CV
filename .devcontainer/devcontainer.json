{
  "name": "Interactive CV",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Private CV preview",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postStartCommand": "python3 -m http.server 8000"
}
